@startuml
skinparam classAttributeIconSize 0

class Hospital {
  - {static} MAX_DAYS : int
  - weather : Weather
  - nurses : ArrayList<Nurse>
  - patient : Patient
  - kitchen : Kitchen
  - listeners : ArrayList<NewDayListener>
  - random : Random
  - day : int
  + runScenario() : void
  - playDay() : void
  - isFinished() : boolean
  - printEnding() : void
}

interface "Hospital.NewDayListener" as NewDayListener <<functional>> {
  + onNewDay() : void
}

class Kitchen {
  - cookedToday : int
  + cook(order : Dish) : Dish
  + onNewDay() : void
  + getCookedToday() : int
  + toString() : String
}

class Weather <<record>> {
  - temperature : double
  - humidity : double
  - wind : double
  + {static} random(r : Random) : Weather
  + next(r : Random) : Weather
  + isCold() : boolean
  + isHot() : boolean
  + isGloomy() : boolean
  + toString() : String
}

abstract class Person {
  - name : String
  - mood : Mood
  # random : Random
  + {abstract} onNewDay(w : Weather) : void
  + getName() : String
  + getMood() : Mood
  # setMood(m : Mood) : void
  + equals(o : Object) : boolean
  + hashCode() : int
  + toString() : String
}

enum Mood {
  CALM
  CAPRICIOUS
  SATISFIED
  TIRED
  EXHAUSTED
  IN_LOVE
  --
  - description : String
  + getDescription() : String
}

class Nurse {
  - {static} MAX_APPROACHES_PER_DAY : int
  - menu : ArrayList<Dish>
  - fatigue : int
  - maxFatigue : int
  - approachesToday : int
  + onNewDay(w : Weather) : void
  + approach(p : Patient, k : Kitchen) : boolean
  + canApproach() : boolean
  + isExhausted() : boolean
  - complain() : void
  - pickFromMenu(wish : Dish) : Dish
  - score(d : Dish, wish : Dish) : int
  - tire(amount : int) : void
  + toString() : String
}

class Patient {
  - {static} LOVE_THRESHOLD : int
  - {static} RECOVERY_HEALTH : int
  - {static} WISHES_PER_DAY : int
  - wishes : ArrayList<Dish>
  - capriciousness : double
  - health : int
  - attraction : Map<Nurse, Integer>
  - weather : Weather
  + onNewDay(w : Weather) : void
  + accept(d : Dish, from : Nurse) : boolean
  + currentWish() : Dish
  + favourite() : Nurse
  + isInLove() : boolean
  + isRecovered() : boolean
  - inventWish() : Dish
  - inventExcuse(d : Dish) : String
  + toString() : String
}

class Dish <<record>> {
  - type : DishType
  - ingredient : Ingredient
  + {static} random(r : Random) : Dish
  + isPossible() : boolean
  + sameTypeAs(other : Dish) : boolean
  + toString() : String
}

enum DishType {
  SOUP
  PORRIDGE
  CUTLET
  PASTA
  PUREE
  KVASS
  JELLY
  --
  - title : String
  - hot : boolean
  - needsSolidBase : boolean
  + weight(w : Weather) : double
  + getTitle() : String
  + needsSolidBase() : boolean
}

enum Ingredient {
  CANDY
  MARMALADE
  CHOCOLATE
  STRAWBERRY
  APPLE
  PEAR
  MUSHROOM
  POTATO
  MEAT
  ONION
  --
  - title : String
  - sweet : boolean
  - solid : boolean
  + getTitle() : String
  + isSweet() : boolean
  + isSolid() : boolean
}

class Exception
class RuntimeException

class ImpossibleDishException {
  - dish : Dish
  + getMessage() : String
}

class NurseExhaustedException {
  - nurseName : String
  + getMessage() : String
}

Hospital *-left- Weather
Hospital +-right- NewDayListener
NewDayListener <|.down. Kitchen
Hospital *-- Kitchen
Hospital -[hidden]down- Person
Hospital o-- "1..*" Nurse
Hospital o-- "1" Patient

Person -right-> Mood
Person <|-- Nurse
Person <|-- Patient
Patient -left-> "*" Nurse : attraction

Nurse o-- "2" Dish : menu
Patient o-- "*" Dish : wishes
Dish *-- DishType
Dish *-- Ingredient

Exception <|-- ImpossibleDishException
Kitchen ..> ImpossibleDishException : throws
RuntimeException <|-- NurseExhaustedException
Nurse .left.> NurseExhaustedException : throws

@enduml
